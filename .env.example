# Server
PORT=5000

# Optional: only required when ALLOW_PERSISTENT_ROOM_STORAGE=true
DATABASE_URL=******localhost:5432/dbname

# Security defaults
# Keep this FALSE to ensure room metadata is NOT stored in the database.
ALLOW_PERSISTENT_ROOM_STORAGE=false

# Keep this FALSE to avoid any server-side call history persistence.
ALLOW_SERVER_CALL_LOGS=false

# Optional explicit origin pinning for websocket origin checks.
# Use APP_ORIGINS for multi-device access (comma-separated), or "*" for trusted private environments.
APP_ORIGIN=http://localhost:5000
APP_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Preferred TURN config (Metered API-based credentials)
METERED_DOMAIN=yourappname.metered.live
METERED_API_KEY=your_metered_api_key
METERED_SECRET_KEY=your_metered_secret_key

# Optional static TURN override (if you want to bypass provider API calls)
TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=your_metered_username
TURN_CREDENTIAL=your_metered_password

# Optional Twilio token-based TURN (advanced)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_TTL_SEC=3600

# Optional: force relay-only routing when TURN is available.
# Values: all | relay
# all = STUN + host candidates (works on most networks without TURN credentials)
# relay = TURN relay only (requires valid TURN credentials configured above)
VITE_ICE_TRANSPORT_POLICY=all
